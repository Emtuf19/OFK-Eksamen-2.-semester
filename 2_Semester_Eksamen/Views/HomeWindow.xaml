<Page
    x:Class="_2_Semester_Eksamen.Views.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_2_Semester_Eksamen.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="HomeWindow"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Background="White"
    mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label
                Grid.Row="0"
                Grid.ColumnSpan="4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                Odense Fægte-Klub
            </Label>

            <!--  List over Træning  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,20,20,30"
                BorderBrush="Black"
                BorderThickness="2">
                <Grid Background="#FFF3F35D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="Bold" Text="Træninger:"/>
                    <TextBlock x:Name="TrainingError_txt" Text="{Binding Error}" Visibility="Collapsed" Grid.Row="0" Margin="10,40,0,0" FontWeight="Bold" FontSize="20"/>
                    <ListBox ItemsSource="{Binding Practices}" FontSize="16" Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock FontWeight="Bold" Text="{Binding PracticeName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Black"/>
                                                
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PracticeName}" Value="Træning Aflyst">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="FontSize" Value="20"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Trainers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Height="1" Fill="Black"></Rectangle>
                                                    <TextBlock FontWeight="Bold" Text="Træner: " />
                                                    <TextBlock Text="{Binding TrainerFirstName}" />
                                                    <TextBlock Text="{Binding TrainerLastName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="Start: " />
                                        <TextBlock Text="{Binding StartTime, StringFormat=dd-MM-yyyy HH:mm}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="Slut: " />
                                        <TextBlock Text="{Binding EndTime, StringFormat=dd-MM-yyyy HH:mm}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!--  Preview over Kalender  -->
            <Border Grid.Row="1" Grid.Column="2" Margin="0,20,20,30" BorderBrush="Black" BorderThickness="2">
                <Grid Background="#FFF3F35D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="Bold" Text="Begivenheder:"/>
                    <TextBlock x:Name="EventError_txt" Grid.Row="0" FontSize="20" Margin="10,40" FontWeight="Bold" Visibility="Collapsed" Text="{Binding ErrorEvent}"/>
                    <ListBox ItemsSource="{Binding Events}" FontSize="16" Grid.Row="1" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock FontWeight="Bold" Text="{Binding EventName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Black"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EventName}" Value="Træning Aflyst">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="FontSize" Value="20"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Trainers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Rectangle Height="1" Fill="Black"></Rectangle>
                                                    <TextBlock FontWeight="Bold" Text="Træner: " />
                                                    <TextBlock Text="{Binding TrainerFirstName}" />
                                                    <TextBlock Text="{Binding TrainerLastName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="Start: " />
                                        <TextBlock Text="{Binding Time, StringFormat=dd-MM-yyyy HH:mm}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">                                       
                                        <TextBlock Text="{Binding Description}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="Pris: " />
                                        <TextBlock Text="{Binding Price}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Text="Alders Gruppe: " />
                                        <TextBlock Text="{Binding AgeGroup}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
