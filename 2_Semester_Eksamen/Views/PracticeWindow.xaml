<Page
    x:Class="_2_Semester_Eksamen.Views.PracticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_2_Semester_Eksamen.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PracticeWindow"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    Background="White"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="20">

            <DatePicker SelectedDate="{Binding SelectedDate}" Margin="5"/>

            <TextBox Text="{Binding PracticeName}" Margin="5"/>
            <TextBox Text="{Binding StartTime, StringFormat=HH:mm, ConverterCulture=da-DK}" Margin="5"/>
            <TextBox Text="{Binding EndTime, StringFormat=HH:mm, ConverterCulture=da-DK}" Margin="5"/>

            <Button Content="Opret træning" Command="{Binding CreatePracticeCommand}"/>
            <Button Content="Rediger træning" Command="{Binding UpdatePracticeCommand}"/>
            <Button Content="Aflys træning" Command="{Binding DeletePracticeCommand}"/>

            <!--  Calendar  -->

            <Calendar SelectedDate="{Binding SelectedDate}">

            </Calendar>



            <!--  Practices list  -->
            <ListBox ItemsSource="{Binding SelectedPractices}"
         SelectedItem="{Binding SelectedPractice}" Height="100">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding PracticeName}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PracticeName}" Value="Træning Aflyst">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontSize" Value="16"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StartTime, ConverterCulture=da-DK}"/>
                            <TextBlock Text="{Binding EndTime, ConverterCulture=da-DK}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </StackPanel>
    </Grid>
</Page>
